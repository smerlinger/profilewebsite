---
import Base from '../layouts/Base.astro';

const working = [
  { title: 'Ryokan', desc: 'An internet company development studio.' },
  { title: 'Ecomportal', desc: 'A job board for the eCommerce industry.' },
  { title: 'Klarako', tag: 'SOLD', desc: 'A modern lighting brand inspired by Scandinavian design.' },
  { title: 'Purple Lotus', tag: 'SOLD', desc: 'A health & wellness brand centered on yoga practice and activewear.' },
];

const help = [
  {
    title: '1-Hour Consultation',
    desc: 'Book a 60-minute call to go over anything — entrepreneurship, eCommerce, paid ads, software, team building, and more.',
  },
];
---

<Base>
  <p class="lead">
    Hi, I'm Shaun. I've built &amp; sold multiple eCommerce brands to 7-figures a year, and I run
    <a href="https://ecomportal.co" target="_blank" rel="noopener">a job board for the eCommerce industry</a>.
    I love running, yoga, meditation, technology, artistry, languages, martial arts, &amp; tea.
    I <a href="/writing">write about entrepreneurship &amp; philosophy</a> and visually share what I learn —
    following my curiosity and documenting the journey.
  </p>

  <p class="section-label">What I'm working on</p>
  <div class="entry-list">
    {working.map((item) => (
      <div class="entry">
        <span class="entry-title">{item.title}{item.tag && <span class="tag">{item.tag}</span>}</span>
        <p class="entry-desc">{item.desc}</p>
      </div>
    ))}
  </div>

  <p class="section-label">How I can help</p>
  <div class="entry-list">
    {help.map((item) => (
      <div class="entry">
        <span class="entry-title">{item.title}</span>
        <p class="entry-desc">{item.desc}</p>
      </div>
    ))}
  </div>
</Base>
