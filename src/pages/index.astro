---
import Base from '../layouts/Base.astro';

const working = [
  { title: 'Not Sure', desc: 'AI is wild. Still figuring it out' },
  { title: 'Ecomportal', tag: 'SOLD', desc: 'A job board for the eCommerce industry.' },
  { title: 'Klarako', tag: 'SOLD', desc: 'A modern lighting brand inspired by Scandinavian design.' },
  { title: 'Purple Lotus', tag: 'SOLD', desc: 'A health & wellness brand centered on yoga practice and activewear.' },
];

const help = [
  {
    title: '1-Hour Consultation',
    desc: 'Book a 60-minute call to go over anything — entrepreneurship, eCommerce, paid ads, software, team building, and more.',
  },
];
---

<Base>
  <p class="lead">
   Live in the future & build what's missing.
  </p>

  <p class="section-label">What I'm working on</p>
  <div class="entry-list">
    {working.map((item) => (
      <div class="entry">
        <span class="entry-title">{item.title}{item.tag && <span class="tag">{item.tag}</span>}</span>
        <p class="entry-desc">{item.desc}</p>
      </div>
    ))}
  </div>
</Base>
