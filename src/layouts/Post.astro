---
import Base from './Base.astro';

interface Props {
  title: string;
  date: Date;
  description?: string;
}

const { title, date, description } = Astro.props;
const dateStr = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={`${title} — Shaun Smerling`} description={description}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-meta"><time datetime={date.toISOString()}>{dateStr}</time></p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
  <a href="/writing" class="back-link">← all writing</a>
</Base>
